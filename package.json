{
  "name": "alljobs",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build --webpack",
    "start": "next start",
    "start:prod": "next start -p 3456 -H 127.0.0.1",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:e2e": "playwright test --config playwright.config.ts && playwright test --config playwright.document-adaptation.config.ts && playwright test --config playwright.document-adaptation-mobile.config.ts && playwright test --config playwright.r2.config.ts && playwright test --config playwright.r5.config.ts",
    "test:e2e:r2": "playwright test --config playwright.r2.config.ts",
    "test:e2e:caphub": "playwright test --config playwright.caphub-foundation.config.ts",
    "test:e2e:caphub-review-registry": "playwright test --config playwright.caphub-review-registry.config.ts",
    "test:e2e:caphub-package-export": "playwright test --config playwright.caphub-package-export.config.ts",
    "test:e2e:caphub-production-pilot": "NODE_OPTIONS=--conditions=react-server playwright test --config playwright.caphub-production-pilot.config.ts",
    "assistant:smoke": "tsx scripts/assistant-smoke.ts",
    "caphub:analyze": "tsx --conditions=react-server scripts/caphub-analyze.ts",
    "caphub:automation-backfill": "tsx --conditions=react-server scripts/caphub-automation-backfill.ts",
    "caphub:worker": "tsx --conditions=react-server scripts/caphub-worker.ts",
    "caphub:project": "tsx --conditions=react-server scripts/caphub-project.ts",
    "caphub:export": "tsx --conditions=react-server scripts/caphub-export.ts",
    "caphub:publish": "tsx --conditions=react-server scripts/caphub-publish.ts",
    "caphub:postgres": "tsx --conditions=react-server scripts/caphub-postgres.ts",
    "caphub:registry-import": "tsx --conditions=react-server scripts/caphub-registry-import.ts",
    "caphub:object-transfer": "tsx --conditions=react-server scripts/caphub-object-transfer.ts",
    "caphub:activation-attest": "tsx --conditions=react-server scripts/caphub-activation-attest.ts",
    "caphub:backup": "tsx --conditions=react-server scripts/caphub-backup.ts",
    "caphub:release": "tsx --conditions=react-server scripts/caphub-release.ts",
    "caphub:preflight": "tsx --conditions=react-server scripts/caphub-production-preflight.ts",
    "planning:refresh": "tsx scripts/planning-refresh.ts",
    "monitoring:refresh": "tsx scripts/monitoring-refresh.ts --once",
    "planning:skill:validate": "node scripts/validate-planning-skill.mjs",
    "verify:deploy": "node scripts/verify-deployment-config.mjs"
  },
  "dependencies": {
    "@ai-sdk/openai": "^4.0.53",
    "@aws-sdk/client-s3": "^3.1134.0",
    "@tesseract.js-data/chi_sim": "^1.0.0",
    "@tesseract.js-data/eng": "^1.0.0",
    "@zxing/library": "^0.23.0",
    "ai": "^7.0.87",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "gray-matter": "^4.0.3",
    "lucide-react": "^1.31.0",
    "next": "16.3.3",
    "pg": "^8.23.0",
    "radix-ui": "^1.6.7",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "server-only": "^0.0.1",
    "shadcn": "^4.16.2",
    "sharp": "^0.35.4",
    "tailwind-merge": "^3.6.0",
    "tesseract.js": "^7.0.0",
    "tw-animate-css": "^1.4.0",
    "yaml": "^2.9.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@playwright/test": "^1.62.1",
    "@tailwindcss/postcss": "^4",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.6",
    "@types/node": "^20",
    "@types/pg": "^8.23.1",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.3.3",
    "jsdom": "^29.1.1",
    "tailwindcss": "^4",
    "tsx": "^4.23.12",
    "typescript": "^5",
    "vitest": "^4.1.10"
  }
}
