{
  "trustedCodeRoots": [
    "/Users/xtation/AgentWorks/CodeSpace",
    "/Users/xtation/AgentWorks/GPT_Workspace"
  ],
  "refreshIntervalSeconds": 300,
  "assistant": {
    "enabled": false,
    "protocol": "openai-compatible",
    "base_url": "https://api.minimax.io/v1",
    "allowedOrigins": [
      "https://alljobs.agentjoey.ai"
    ]
  },
  "caphub": {
    "enabled": false,
    "allowedOrigins": ["https://alljobs.agentjoey.ai"],
    "maxUploadBytes": 10485760,
    "retention": { "enabled": false },
    "analysis": {
      "enabled": false,
      "autoStart": false,
      "concurrency": 1,
      "miniMaxBaseUrl": "https://api.minimax.io/v1",
      "miniMaxModel": "MiniMax-M3",
      "miniMaxSecretEnv": "MINIMAX_API_KEY",
      "deepSeekApiBaseUrl": "https://api.deepseek.com",
      "deepSeekApiModel": "deepseek-flash",
      "deepSeekApiSecretEnv": "DEEPSEEK_API_KEY",
      "sourceAllowedOrigins": []
    },
    "registry": {
      "enabled": false,
      "databaseUrlEnv": "CAPHUB_DATABASE_URL",
      "migrationDatabaseUrlEnv": "CAPHUB_MIGRATION_DATABASE_URL",
      "connectionMode": "tls_verify_full",
      "managedHosts": ["registry.example.test"],
      "maxConnections": 4,
      "statementTimeoutMs": 5000
    },
    "storage": {
      "mode": "local"
    },
    "exports": {
      "enabled": false,
      "obsidian": { "enabled": false },
      "packageRepository": { "enabled": false },
      "targets": {
        "codex": { "enabled": false },
        "claude": { "enabled": false },
        "hermes": { "enabled": false }
      }
    }
  },
  "monitoring": {
    "enabled": false,
    "refreshIntervalSeconds": 300,
    "concurrency": 3,
    "credentials": {
      "example-railway-ref": {
        "provider": "railway",
        "tokenEnv": "EXAMPLE_ONLY_MONITORING_TOKEN_ENV"
      }
    },
    "probeAllowedHosts": {
      "example-production-host": "https://app.example.invalid"
    }
  }
}
