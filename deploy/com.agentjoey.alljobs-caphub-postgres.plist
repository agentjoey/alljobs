<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.agentjoey.alljobs-caphub-postgres</string>

    <key>ProgramArguments</key>
    <array>
        <string>/opt/homebrew/opt/postgresql@17/bin/postgres</string>
        <string>-D</string>
        <string>&lt;ALLJOBS_HOME&gt;/postgres/caphub</string>
    </array>

    <key>KeepAlive</key>
    <true/>
    <key>RunAtLoad</key>
    <true/>

    <key>StandardOutPath</key>
    <string>/Users/&lt;USERNAME&gt;/Library/Logs/alljobs/caphub-postgres-stdout.log</string>
    <key>StandardErrorPath</key>
    <string>/Users/&lt;USERNAME&gt;/Library/Logs/alljobs/caphub-postgres-stderr.log</string>
</dict>
</plist>
