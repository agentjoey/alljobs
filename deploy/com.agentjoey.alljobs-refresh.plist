<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.agentjoey.alljobs-refresh</string>

    <key>ProgramArguments</key>
    <array>
        <string>&lt;NODE_BIN_DIR&gt;/npm</string>
        <string>run</string>
        <string>planning:refresh</string>
    </array>

    <key>WorkingDirectory</key>
    <string>&lt;REPO_ABS_PATH&gt;</string>

    <key>KeepAlive</key>
    <true/>
    <key>RunAtLoad</key>
    <true/>

    <key>StandardOutPath</key>
    <string>/Users/&lt;USERNAME&gt;/Library/Logs/alljobs/refresh-stdout.log</string>
    <key>StandardErrorPath</key>
    <string>/Users/&lt;USERNAME&gt;/Library/Logs/alljobs/refresh-stderr.log</string>

    <key>EnvironmentVariables</key>
    <dict>
        <key>PATH</key>
        <string>&lt;NODE_BIN_DIR&gt;:/usr/local/bin:/usr/bin:/bin</string>
    </dict>
</dict>
</plist>
